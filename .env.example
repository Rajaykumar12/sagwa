# The only external API this project calls: the LLM judge (Groq free tier).
# Reuses the same provider ringo already uses, which is what makes the
# calibration head-to-head against ringo/backend/eval.py an apples-to-apples
# comparison (see docs/adr/0001-project-naming.md's sibling ADRs for context).
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Local SQLite file, no cloud dependency and no service to run. See
# docs/adr/0004-sqlite-default-defer-postgres.md for the Postgres migration path.
DATABASE_URL=sqlite:///./sagwa.db

# Target-pipeline-specific env vars (e.g. RINGO_REPO_PATH for the example
# ringo adapter) are NOT listed here — each adapter owns its own
# configuration. See examples/adapters/README.md.

# Optional per-role model routing. Judging, RAGAS scoring and cluster labelling
# are different jobs with different quality needs — and, on a rate-limited tier,
# routing them to different models gives each its own per-model budget.
# SAGWA_JUDGE_MODEL=openai/gpt-oss-20b
# SAGWA_RAGAS_MODEL=openai/gpt-oss-120b
# SAGWA_CLUSTER_MODEL=openai/gpt-oss-20b
# Comma-separated subset of RAGAS metrics to compute; unset computes all.
# Empty means none, which makes a run dramatically faster and cheaper.
# SAGWA_RAGAS_METRICS=faithfulness
